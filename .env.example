# Required. Create one in the InstaBox dashboard under "API keys".
INSTABOX_API_KEY=ibk_...

# Optional (this is the default)
# INSTABOX_API_URL=https://api.instabox.sh

# Optional: hide every tool that changes anything (create, exec, delete, ...)
# INSTABOX_READ_ONLY=true

# Optional: cap on characters of command output / file content returned to the model
# INSTABOX_MAX_OUTPUT_CHARS=60000
